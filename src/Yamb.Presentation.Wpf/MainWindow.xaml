<Window x:Class="Yamb.Presentation.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jamb"
        Width="1220"
        Height="840"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        PreviewKeyDown="OnWindowPreviewKeyDown">
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Ellipse Width="820"
                     Height="820"
                     Fill="{DynamicResource GlowBrush}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Top"
                     Margin="0,-460,0,0"
                     IsHitTestVisible="False" />

            <Ellipse Width="560"
                     Height="560"
                     Fill="{DynamicResource WindowGlowSecondaryBrush}"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Bottom"
                     Margin="0,0,-210,-300"
                     Opacity="0.65"
                     IsHitTestVisible="False" />

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Height="62"
                        Background="{DynamicResource TitleBarBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="OnTitleBarMouseDown">
                    <Grid Margin="20,0,12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="30"
                                    Height="30"
                                    CornerRadius="10"
                                    Background="{DynamicResource AccentButtonBrush}"
                                    Effect="{DynamicResource AccentGlow}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="Y"
                                           Foreground="{DynamicResource OnAccentBrush}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="YAMB"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center"
                                       Margin="11,0,0,0" />
                            <Border Width="1"
                                    Height="18"
                                    Background="{DynamicResource BorderBrush}"
                                    Margin="16,0"
                                    VerticalAlignment="Center" />
                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Padding="11,5">
                                <TextBlock x:Name="BreadcrumbText"
                                           FontSize="12.5"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Button x:Name="FullscreenButton"
                                    Content="&#xE740;"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="14"
                                    Style="{StaticResource CaptionButtonStyle}"
                                    ToolTip="{DynamicResource L.Main.Fullscreen}"
                                    Click="OnFullscreenClick"
                                    AutomationProperties.AutomationId="WindowFullscreen" />
                            <Button Content="&#x2013;"
                                    Style="{StaticResource CaptionButtonStyle}"
                                    Margin="4,0,0,0"
                                    Click="OnMinimizeClick"
                                    AutomationProperties.AutomationId="WindowMinimize" />
                            <Button Content="&#x2715;"
                                    Style="{StaticResource CloseCaptionButtonStyle}"
                                    Margin="4,0,0,0"
                                    Click="OnCloseClick"
                                    AutomationProperties.AutomationId="WindowClose" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ContentControl x:Name="PageHost"
                                Grid.Row="1"
                                Margin="28,12,28,24"
                                Focusable="False" />
            </Grid>

            <Rectangle Height="3"
                       Fill="{DynamicResource TopAccentBrush}"
                       VerticalAlignment="Top"
                       IsHitTestVisible="False" />
        </Grid>
    </Border>
</Window>
