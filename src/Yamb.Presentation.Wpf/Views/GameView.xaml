<UserControl x:Class="Yamb.Presentation.Wpf.Views.GameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Yamb.Presentation.Wpf"
             FontFamily="Segoe UI"
             Focusable="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{DynamicResource AccentSoftBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6"
                                 Height="6"
                                 Fill="{DynamicResource AccentBrush}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0" />
                        <TextBlock x:Name="HeaderText"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   AutomationProperties.AutomationId="HeaderText" />
                    </StackPanel>
                </Border>
                <TextBlock x:Name="TurnText"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Grid x:Name="ThinkingPill"
                      Visibility="Collapsed"
                      Margin="0,0,16,0"
                      AutomationProperties.AutomationId="BotThinkingIndicator">
                    <Border Background="{DynamicResource AccentSoftBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="999"
                            Padding="10,5">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.18" />
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="5" Height="5" Margin="0,0,4,0" Fill="{DynamicResource AccentBrush}">
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard Timeline.DesiredFrameRate="{x:Static local:WpfSettings.AnimationFps}" RepeatBehavior="Forever">
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity"
                                                                               Duration="0:0:1.2">
                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.25" />
                                                    <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="1" />
                                                    <EasingDoubleKeyFrame KeyTime="0:0:0.9" Value="0.25" />
                                                </DoubleAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <Ellipse Width="5" Height="5" Margin="0,0,4,0" Fill="{DynamicResource AccentBrush}">
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard Timeline.DesiredFrameRate="{x:Static local:WpfSettings.AnimationFps}" RepeatBehavior="Forever" BeginTime="0:0:0.15">
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity"
                                                                               Duration="0:0:1.2">
                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.25" />
                                                    <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="1" />
                                                    <EasingDoubleKeyFrame KeyTime="0:0:0.9" Value="0.25" />
                                                </DoubleAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <Ellipse Width="5" Height="5" Margin="0,0,8,0" Fill="{DynamicResource AccentBrush}">
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard Timeline.DesiredFrameRate="{x:Static local:WpfSettings.AnimationFps}" RepeatBehavior="Forever" BeginTime="0:0:0.3">
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity"
                                                                               Duration="0:0:1.2">
                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.25" />
                                                    <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="1" />
                                                    <EasingDoubleKeyFrame KeyTime="0:0:0.9" Value="0.25" />
                                                </DoubleAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <TextBlock Text="{DynamicResource L.Game.BotThinking}"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center"
                                       AutomationProperties.AutomationId="BotThinkingText" />
                        </StackPanel>
                    </Border>
                </Grid>
                <TextBlock Text="{DynamicResource L.Game.Shortcuts}"
                           FontSize="10.5"
                           Foreground="{DynamicResource MutedTextBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,18,0" />
                <Button x:Name="MenuButton"
                        Content="{DynamicResource L.Nav.Menu}"
                        Width="86"
                        Style="{StaticResource SmallButtonStyle}"
                        Click="OnMenuClick"
                        AutomationProperties.AutomationId="MenuButton" />
            </StackPanel>
        </Grid>

        <Grid x:Name="ContentGrid" Grid.Row="1" />

        <Grid x:Name="PopupOverlay"
              Grid.RowSpan="2"
              Visibility="Collapsed"
              Background="{DynamicResource PopupShadeBrush}">
            <Border x:Name="PopupPanel"
                    Style="{StaticResource PopupPanelStyle}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="PopupTitle"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"
                               HorizontalAlignment="Center"
                               AutomationProperties.AutomationId="PopupTitle" />
                    <TextBlock x:Name="PopupText"
                               FontSize="14"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,10,0,0"
                               AutomationProperties.AutomationId="PopupText" />
                    <StackPanel x:Name="PopupButtons"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,20,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
