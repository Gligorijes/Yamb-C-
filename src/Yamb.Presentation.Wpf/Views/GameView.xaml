<UserControl x:Class="Yamb.Presentation.Wpf.Views.GameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{DynamicResource AccentSoftBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,6">
                    <TextBlock x:Name="HeaderText"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               AutomationProperties.AutomationId="HeaderText" />
                </Border>
                <TextBlock x:Name="TurnText"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0" />
            </StackPanel>
            <Button x:Name="MenuButton"
                    Content="Meni"
                    Width="86"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Style="{StaticResource SmallButtonStyle}"
                    Click="OnMenuClick"
                    AutomationProperties.AutomationId="MenuButton" />
        </Grid>

        <Grid x:Name="ContentGrid" Grid.Row="1" />

        <Grid x:Name="PopupOverlay"
              Grid.RowSpan="2"
              Visibility="Collapsed"
              Background="{DynamicResource PopupShadeBrush}">
            <Border x:Name="PopupPanel"
                    Style="{StaticResource PopupPanelStyle}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="PopupTitle"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"
                               HorizontalAlignment="Center"
                               AutomationProperties.AutomationId="PopupTitle" />
                    <TextBlock x:Name="PopupText"
                               FontSize="14"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,10,0,0"
                               AutomationProperties.AutomationId="PopupText" />
                    <StackPanel x:Name="PopupButtons"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,20,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
