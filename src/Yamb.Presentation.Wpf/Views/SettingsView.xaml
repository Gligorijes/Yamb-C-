<UserControl x:Class="Yamb.Presentation.Wpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{DynamicResource L.Settings.Eyebrow}"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="{DynamicResource MutedTextBrush}" />
            <TextBlock Text="{DynamicResource L.Settings.Title}"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}"
                       Margin="0,8,0,0" />
            <TextBlock Text="{DynamicResource L.Settings.Subtitle}"
                       FontSize="12.5"
                       Foreground="{DynamicResource MutedTextBrush}"
                       Margin="0,6,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      Margin="0,20,0,0"
                      Padding="0,0,4,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="1040" HorizontalAlignment="Center">
                <Border Background="{DynamicResource PanelGradientBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="24,20"
                        Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource L.Settings.Theme}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock Text="{DynamicResource L.Settings.ThemeHint}"
                                           FontSize="12"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12,5"
                                    VerticalAlignment="Center">
                                <TextBlock Text="6"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </Border>
                        </Grid>

                        <Grid x:Name="ThemeGrid" Grid.Row="1" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{DynamicResource PanelGradientBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="24,20"
                            Effect="{StaticResource CardShadow}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource L.Settings.Face}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource MutedTextBrush}" />

                            <RadioButton x:Name="PipsRadio"
                                         IsChecked="True"
                                         GroupName="DiceFace"
                                         Height="60"
                                         Padding="14,10"
                                         Margin="0,12,0,0"
                                         Style="{StaticResource ModeCardStyle}"
                                         Checked="OnFaceStyleChanged"
                                         AutomationProperties.AutomationId="FacePips">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34"
                                            Height="34"
                                            CornerRadius="10"
                                            Background="{DynamicResource SettingsIconBrush}">
                                        <TextBlock Text="&#x2684;"
                                                   FontFamily="Segoe UI Symbol"
                                                   FontSize="18"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource L.Settings.Pips}" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="{DynamicResource L.Settings.PipsSubtitle}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                            </RadioButton>

                            <RadioButton x:Name="NumbersRadio"
                                         GroupName="DiceFace"
                                         Height="60"
                                         Padding="14,10"
                                         Margin="0,10,0,0"
                                         Style="{StaticResource ModeCardStyle}"
                                         Checked="OnFaceStyleChanged"
                                         AutomationProperties.AutomationId="FaceNumbers">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34"
                                            Height="34"
                                            CornerRadius="10"
                                            Background="{DynamicResource SettingsIconBrush}">
                                        <TextBlock Text="6"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource L.Settings.Numbers}" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="{DynamicResource L.Settings.NumbersSubtitle}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                            </RadioButton>

                            <RadioButton x:Name="RomanRadio"
                                         GroupName="DiceFace"
                                         Height="60"
                                         Padding="14,10"
                                         Margin="0,10,0,0"
                                         Style="{StaticResource ModeCardStyle}"
                                         Checked="OnFaceStyleChanged"
                                         AutomationProperties.AutomationId="FaceRoman">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34"
                                            Height="34"
                                            CornerRadius="10"
                                            Background="{DynamicResource SettingsIconBrush}">
                                        <TextBlock Text="VI"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource L.Settings.Roman}" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="{DynamicResource L.Settings.RomanSubtitle}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                            </RadioButton>

                            <Border Height="1"
                                    Background="{DynamicResource BorderBrush}"
                                    Margin="0,18,0,16" />

                            <Grid>
                                <TextBlock Text="{DynamicResource L.Settings.Size}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="SizeText"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <Slider x:Name="SizeSlider"
                                    Minimum="36"
                                    Maximum="72"
                                    TickFrequency="2"
                                    IsSnapToTickEnabled="True"
                                    Value="54"
                                    Margin="0,12,0,0"
                                    ValueChanged="OnSizeChanged"
                                    AutomationProperties.AutomationId="DieSizeSlider" />

                            <Border Height="1"
                                    Background="{DynamicResource BorderBrush}"
                                    Margin="0,18,0,16" />

                            <Grid>
                                <TextBlock Text="{DynamicResource L.Settings.AnimationFps}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="AnimationFpsText"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           AutomationProperties.AutomationId="AnimationFpsText" />
                            </Grid>

                            <Slider x:Name="AnimationFpsSlider"
                                    Minimum="24"
                                    Maximum="999"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Value="165"
                                    Margin="0,12,0,0"
                                    ValueChanged="OnAnimationFpsChanged"
                                    AutomationProperties.AutomationId="AnimationFpsSlider" />

                            <TextBlock Text="{DynamicResource L.Settings.AnimationFpsHint}"
                                       FontSize="11"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap" />

                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Height="112"
                                    Margin="0,18,0,0">
                                <WrapPanel x:Name="PreviewPanel"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>

                            <TextBlock Text="{DynamicResource L.Settings.Preview}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Background="{DynamicResource PanelGradientBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="24,20"
                            Effect="{StaticResource CardShadow}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource L.Settings.DiceCount}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource MutedTextBrush}" />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <RadioButton x:Name="DiceFiveRadio"
                                             Grid.Column="0"
                                             GroupName="DiceCount"
                                             Height="66"
                                             Padding="10,8"
                                             Style="{StaticResource ModeCardStyle}"
                                             Checked="OnDiceCountChanged"
                                             AutomationProperties.AutomationId="DiceFive">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="{DynamicResource L.Settings.DiceFive}"
                                                   FontSize="22"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                        <TextBlock Text="{DynamicResource L.Settings.DiceUnit}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Margin="7,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="DiceSixRadio"
                                             Grid.Column="2"
                                             GroupName="DiceCount"
                                             Height="66"
                                             Padding="10,8"
                                             Style="{StaticResource ModeCardStyle}"
                                             Checked="OnDiceCountChanged"
                                             AutomationProperties.AutomationId="DiceSix">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="{DynamicResource L.Settings.DiceSix}"
                                                   FontSize="22"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                        <TextBlock Text="{DynamicResource L.Settings.DiceUnit}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Margin="7,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                            </Grid>

                            <Border Height="1"
                                    Background="{DynamicResource BorderBrush}"
                                    Margin="0,18,0,16" />

                            <TextBlock Text="{DynamicResource L.Settings.Language}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource MutedTextBrush}" />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <RadioButton x:Name="LanguageSerbianRadio"
                                             Grid.Column="0"
                                             GroupName="Language"
                                             Content="Srpski"
                                             FontSize="13"
                                             Checked="OnLanguageChanged"
                                             AutomationProperties.AutomationId="LanguageSerbian" />

                                <RadioButton x:Name="LanguageEnglishRadio"
                                             Grid.Column="2"
                                             GroupName="Language"
                                             Content="English"
                                             FontSize="13"
                                             Checked="OnLanguageChanged"
                                             AutomationProperties.AutomationId="LanguageEnglish" />
                            </Grid>

                            <Border Height="1"
                                    Background="{DynamicResource BorderBrush}"
                                    Margin="0,18,0,16" />

                            <TextBlock Text="{DynamicResource L.Settings.AutoCalculate}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource MutedTextBrush}" />

                            <CheckBox x:Name="AutoCalculateCheck"
                                      Margin="0,12,0,0"
                                      Checked="OnAutoCalculateChanged"
                                      Unchecked="OnAutoCalculateChanged"
                                      AutomationProperties.AutomationId="AutoCalculate">
                                <TextBlock Text="{DynamicResource L.Settings.AutoCalculateOption}"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </CheckBox>

                            <Border Background="{DynamicResource AccentSoftBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="14,10"
                                    Margin="0,18,0,0">
                                <TextBlock TextWrapping="Wrap"
                                           FontSize="12"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Text="{DynamicResource L.Settings.StraightInfo}" />
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Button Content="{DynamicResource L.Settings.Reset}"
                    HorizontalAlignment="Left"
                    Style="{StaticResource DialogButtonStyle}"
                    Click="OnResetClick"
                    AutomationProperties.AutomationId="SettingsReset" />
            <Button Content="{DynamicResource L.Settings.Back}"
                    HorizontalAlignment="Right"
                    Style="{StaticResource DialogButtonStyle}"
                    Click="OnBackClick"
                    AutomationProperties.AutomationId="SettingsBack" />
        </Grid>
    </Grid>
</UserControl>
