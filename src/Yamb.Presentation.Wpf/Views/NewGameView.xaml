<UserControl x:Class="Yamb.Presentation.Wpf.Views.NewGameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{DynamicResource L.New.Eyebrow}"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="{DynamicResource MutedTextBrush}" />
            <TextBlock Text="{DynamicResource L.New.Title}"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}"
                       Margin="0,8,0,0" />
            <TextBlock Text="{DynamicResource L.New.Subtitle}"
                       FontSize="12.5"
                       Foreground="{DynamicResource MutedTextBrush}"
                       Margin="0,6,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,22,0,0" VerticalAlignment="Top">
            <Border x:Name="StepOnePanel"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="26,24"
                    MaxWidth="980"
                    HorizontalAlignment="Center"
                    Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource L.New.Step1}"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock Text="{DynamicResource L.New.Step1Title}"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"
                               Margin="0,8,0,0" />
                    <TextBlock Text="{DynamicResource L.New.Step1Subtitle}"
                               FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0" />

                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <RadioButton x:Name="ColumnFourRadio"
                                     Grid.Row="0"
                                     Grid.Column="0"
                                     GroupName="Columns"
                                     Height="104"
                                     Style="{StaticResource ModeCardStyle}"
                                     AutomationProperties.AutomationId="ColumnFour">
                            <StackPanel>
                                <TextBlock Text="4"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text="{DynamicResource L.New.Columns4}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Margin="0,2,0,0" />
                                <TextBlock Text="{DynamicResource L.New.Variant4}"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="ColumnSixRadio"
                                     Grid.Row="0"
                                     Grid.Column="2"
                                     GroupName="Columns"
                                     Height="104"
                                     Style="{StaticResource ModeCardStyle}"
                                     AutomationProperties.AutomationId="ColumnSix">
                            <StackPanel>
                                <TextBlock Text="6"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text="{DynamicResource L.New.ColumnsMany}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Margin="0,2,0,0" />
                                <TextBlock Text="{DynamicResource L.New.Variant6}"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="ColumnSevenRadio"
                                     Grid.Row="0"
                                     Grid.Column="4"
                                     GroupName="Columns"
                                     Height="104"
                                     IsChecked="True"
                                     Style="{StaticResource ModeCardStyle}"
                                     AutomationProperties.AutomationId="ColumnSeven">
                            <StackPanel>
                                <TextBlock Text="7"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text="{DynamicResource L.New.ColumnsMany}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Margin="0,2,0,0" />
                                <TextBlock Text="{DynamicResource L.New.Variant7}"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="ColumnEightRadio"
                                     Grid.Row="2"
                                     Grid.Column="0"
                                     GroupName="Columns"
                                     Height="104"
                                     Style="{StaticResource ModeCardStyle}"
                                     AutomationProperties.AutomationId="ColumnEight">
                            <StackPanel>
                                <TextBlock Text="8"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text="{DynamicResource L.New.ColumnsMany}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Margin="0,2,0,0" />
                                <TextBlock Text="{DynamicResource L.New.Variant8}"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="ColumnNineRadio"
                                     Grid.Row="2"
                                     Grid.Column="2"
                                     GroupName="Columns"
                                     Height="104"
                                     Style="{StaticResource ModeCardStyle}"
                                     AutomationProperties.AutomationId="ColumnNine">
                            <StackPanel>
                                <TextBlock Text="9"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text="{DynamicResource L.New.ColumnsMany}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Margin="0,2,0,0" />
                                <TextBlock Text="{DynamicResource L.New.Variant9}"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="ColumnTenRadio"
                                     Grid.Row="2"
                                     Grid.Column="4"
                                     GroupName="Columns"
                                     Height="104"
                                     Style="{StaticResource ModeCardStyle}"
                                     AutomationProperties.AutomationId="ColumnTen">
                            <StackPanel>
                                <TextBlock Text="10"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text="{DynamicResource L.New.ColumnsMany}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Margin="0,2,0,0" />
                                <TextBlock Text="{DynamicResource L.New.Variant10}"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </RadioButton>
                    </Grid>
                </StackPanel>
            </Border>

            <Border x:Name="StepTwoPanel"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="26,24"
                    MaxWidth="980"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed"
                    Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource L.New.Step2}"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock Text="{DynamicResource L.New.Step2Title}"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"
                               Margin="0,8,0,0" />
                    <TextBlock Text="{DynamicResource L.New.Step2Subtitle}"
                               FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0" />

                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <RadioButton x:Name="SingleRadio"
                                     Grid.Column="0"
                                     Height="118"
                                     IsChecked="True"
                                     Style="{StaticResource ModeCardStyle}"
                                     Checked="OnModeChanged"
                                     AutomationProperties.AutomationId="ModeSingle">
                            <StackPanel>
                                <TextBlock Text="1"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text="{DynamicResource L.New.OnePlayer}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Margin="0,2,0,0" />
                                <TextBlock Text="{DynamicResource L.New.OnePlayerSubtitle}"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="TwoRadio"
                                     Grid.Column="2"
                                     Height="118"
                                     Style="{StaticResource ModeCardStyle}"
                                     Checked="OnModeChanged"
                                     AutomationProperties.AutomationId="ModeTwo">
                            <StackPanel>
                                <TextBlock Text="2"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text="{DynamicResource L.New.TwoPlayers}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Margin="0,2,0,0" />
                                <TextBlock Text="{DynamicResource L.New.TwoPlayersSubtitle}"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </RadioButton>
                    </Grid>
                </StackPanel>
            </Border>

            <Border x:Name="StepThreePanel"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="26,24"
                    MaxWidth="720"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed"
                    Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource L.New.Step3}"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock Text="{DynamicResource L.New.Step3Title}"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"
                               Margin="0,8,0,0" />
                    <TextBlock Text="{DynamicResource L.New.Step3Subtitle}"
                               FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0" />

                    <TextBlock Text="{DynamicResource L.New.Player1}"
                               FontSize="12.5"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,20,0,6" />
                    <TextBox x:Name="Player1Box"
                             Height="42"
                             AutomationProperties.AutomationId="Player1Name" />

                    <StackPanel x:Name="Player2Group" Visibility="Collapsed">
                        <TextBlock Text="{DynamicResource L.New.Player2}"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,14,0,6" />
                        <TextBox x:Name="Player2Box"
                                 Height="42"
                                 IsEnabled="False"
                                 AutomationProperties.AutomationId="Player2Name" />
                    </StackPanel>

                    <Border Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14,10"
                            Margin="0,18,0,0">
                        <TextBlock Text="{DynamicResource L.New.Tip}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <TextBlock x:Name="StepText"
                       Text="{DynamicResource L.New.StepCount}"
                       FontSize="12.5"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource MutedTextBrush}"
                       VerticalAlignment="Center"
                       AutomationProperties.AutomationId="NewGameStep" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BackButton"
                        Content="{DynamicResource L.New.Back}"
                        Style="{StaticResource DialogButtonStyle}"
                        Margin="0,0,12,0"
                        Click="OnBackStepClick"
                        AutomationProperties.AutomationId="NewGameBack" />
                <Button x:Name="NextButton"
                        Content="{DynamicResource L.New.Next}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="150"
                        Click="OnNextClick"
                        AutomationProperties.AutomationId="NewGameNext" />
                <Button x:Name="StartButton"
                        Content="{DynamicResource L.New.Start}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="150"
                        Visibility="Collapsed"
                        Click="OnStartClick"
                        AutomationProperties.AutomationId="StartGame" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

