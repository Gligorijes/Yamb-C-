        <GradientStop Color="#18130D" Offset="1" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="GlowBrush" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#4DEDD5A8" Offset="0" />
        <GradientStop Color="#00EDD5A8" Offset="1" />
    </RadialGradientBrush>

