    <SolidColorBrush x:Key="DieWhiteBrush" Color="#FFFFFF" />

    <DropShadowEffect x:Key="AccentGlow" Color="#D6336C" BlurRadius="22" ShadowDepth="0" Opacity="0.3" />

    <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFF8FA" Offset="0" />
        <GradientStop Color="#FFF1F4" Offset="0.55" />
        <GradientStop Color="#FCE0E9" Offset="1" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="GlowBrush" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#33D6336C" Offset="0" />
        <GradientStop Color="#00D6336C" Offset="1" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="WindowGlowSecondaryBrush" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#334DABFF" Offset="0" />
        <GradientStop Color="#004DABFF" Offset="1" />
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="TopAccentBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#D6336C" Offset="0" />
        <GradientStop Color="#FF758F" Offset="0.55" />
        <GradientStop Color="#FFB3C6" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentButtonBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E64980" Offset="0" />
        <GradientStop Color="#A4123F" Offset="1" />
