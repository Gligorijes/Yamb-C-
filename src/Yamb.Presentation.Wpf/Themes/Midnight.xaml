    <DropShadowEffect x:Key="AccentGlow" Color="#57D4FF" BlurRadius="22" ShadowDepth="0" Opacity="0.32" />

    <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
