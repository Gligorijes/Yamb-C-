        <GradientStop Color="#071320" Offset="0.55" />
        <GradientStop Color="#06101B" Offset="1" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="GlowBrush" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#4D57D4FF" Offset="0" />
        <GradientStop Color="#0057D4FF" Offset="1" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="WindowGlowSecondaryBrush" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#355B6CFF" Offset="0" />
        <GradientStop Color="#005B6CFF" Offset="1" />
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="TopAccentBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#57D4FF" Offset="0" />
